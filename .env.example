# Copiez ce fichier en `.env` puis ajustez, OU exportez ces variables dans le shell.
# Toutes les variables sont optionnelles : les valeurs par défaut sont dans server/config.js.

# ---------- Serveur ----------
HOST=0.0.0.0
PORT=8080

# HTTPS obligatoire pour WebXR/WebCodecs sur le casque.
#
# Recommandé : certificat approuvé délivré par Tailscale (aucun avertissement à
# accepter sur le casque) :
#     bash scripts/tailscale-cert.sh   puis   TLS=1 npm start
#
# Repli : certificat auto-signé (il faudra accepter l'avertissement sur le casque) :
#     bash scripts/gen-cert.sh         puis   TLS=1 npm start
#
# Le certificat auto-signé couvre localhost ET toutes les adresses IPv4 locales.
# Si l'adresse de la machine change, il ne couvre plus rien : régénérez-le.
# `npm run doctor` vérifie cette couverture pour vous.
TLS=0
TLS_CERT=./certs/cert.pem
TLS_KEY=./certs/key.pem

# ---------- Profil de qualité ----------
# lan (défaut) : rien ne change, on garde le débit maximal.
# tailscale    : le flux traverse un tunnel ; on réduit le débit et on resserre
#                la file d'attente pour que la latence ne s'envole pas. Utile
#                dès que le trafic est relayé (DERP) ou que le lien est faible.
#                Raccourci : npm run start:tailscale
#
# Le profil s'applique PAR-DESSUS les valeurs de ce fichier (il est fait pour
# ça), mais une variable passée au shell reste prioritaire :
#     BITRATE=2M PROFILE=tailscale npm start
PROFILE=lan

# ---------- Source vidéo ----------
# v4l2 (Linux/WSL2) | dshow (Windows ffmpeg.exe) | rtsp | stdin | test
SOURCE=v4l2
DEVICE=/dev/video0
# Nom exact de la caméra pour dshow : `ffmpeg -list_devices true -f dshow -i dummy`
DSHOW_NAME=USB Camera
RTSP_URL=
# mjpeg | yuyv422 | (vide pour laisser ffmpeg choisir)
INPUT_FORMAT=mjpeg

# Résolution NATIVE de la caméra stéréo (une seule image, les 2 yeux côte à côte).
# Sur cette caméra : 2560x720 = 2 x 1280x720 par œil (le seul mode 30 fps).
# Vérifiez les modes réellement supportés avec `npm run probe`.
WIDTH=2560
HEIGHT=720
FPS=30

# ---------- Encodage ----------
# libx264 (CPU) | h264_nvenc (NVIDIA) | h264_qsv (Intel) | h264_amf (AMD) | h264_vaapi (Linux)
ENCODER=libx264
# Preset x264 (ignoré pour les encodeurs matériels).
# ultrafast = latence minimale mais déblocage désactivé (artefacts possibles) ;
# superfast / veryfast = meilleure image pour quelques ms de plus. Essayez si vous
# voyez du « blocking » dans le casque.
PRESET=ultrafast
BITRATE=12M
BUFSIZE=1M
# Intervalle entre images clés. Plus petit = reprise plus rapide, mais plus de débit.
GOP=30
VAAPI_DEVICE=/dev/dri/renderD128

# ---------- Divers ----------
# sbs = stéréo côte-à-côte | mono = une seule image
STEREO=sbs
# Octets en attente sur un socket avant de larguer des images (anti-bufferbloat)
MAX_BUFFERED=2000000
# Chemin vers le binaire ffmpeg (si absent du PATH)
FFMPEG=ffmpeg
